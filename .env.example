# =============================================================================
# NEXTRADE — BACKEND WORKER PRODUCTION CONFIGURATION (.env)
# Host on Render, Railway, Fly.io, or VPS
# KEEP THIS FILE STRICTLY SERVER-SIDE. NEVER COMMIT TO GIT OR EXPOSE TO BROWSER.
# =============================================================================

# 1. Supabase Database & Project Configuration
# Connect using direct port 5432 or connection pooler port 6543 (transaction mode)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-SUPABASE-PASSWORD]@db.rdlvisbqksxepcgpcusp.supabase.co:5432/postgres
SUPABASE_URL=https://rdlvisbqksxepcgpcusp.supabase.co
# Service role key: SERVER-SIDE ONLY. Bypasses RLS for worker operations.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=sb_publishable_g5LAiBX5GWB5y9Crv2uBZw_nLg57m0o

# 2. Kotak Neo API Credentials (STRICTLY SERVER-SIDE)
KOTAK_CONSUMER_KEY=your_kotak_consumer_key
KOTAK_CONSUMER_SECRET=your_kotak_consumer_secret
KOTAK_MOBILE_NUMBER=your_registered_mobile_number
KOTAK_UCC=your_client_code
KOTAK_ACCESS_TOKEN=
KOTAK_MPIN=your_mpin
KOTAK_TOTP_KEY=your_totp_secret_key
KOTAK_ENVIRONMENT=prod

# 3. Application & CORS Settings
APP_ENV=production
APP_PORT=8005
APP_HOST=0.0.0.0
# Add your deployed Vercel frontend URL here (comma-separated, no trailing slash)
CORS_ORIGINS=https://your-nextrade-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# 4. Virtual Paper Trading Risk & Session Settings (PAPER TRADING ONLY)
PAPER_INITIAL_CAPITAL=100000.0
PAPER_DEFAULT_LOTS=1
PAPER_TARGET_POINTS=4.0
PAPER_STOP_POINTS=4.0
PAPER_MAX_LOSS_PER_TRADE=1000.0
PAPER_FORCE_EXIT_TIME=15:20
PAPER_SESSION_START_TIME=09:20
PAPER_SESSION_END_TIME=15:15
